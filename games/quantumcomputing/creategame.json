  "learning_objectives": [
    {
      "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"#8b5cf6\" stroke-width=\"1.8\"/><path d=\"M4.5 9c3-2.4 12-2.4 15 0M4.5 15c3 2.4 12 2.4 15 0\" stroke=\"#c4b5fd\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"#8b5cf6\"/></svg>",
      "title": "Quantum Bits (Qubits)",
      "description": "A classical bit is an electrical circuit, always definitely on or off. A qubit is the state of an elementary particle, such as an electron, ion, or photon, that holds a mix of 0 and 1 at once (superposition) until measured, enabling Grover's Algorithm to search 256 possible codes in far fewer steps than checking them one at a time"
    },
    {
      "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2 8c2 0 2 4 4 4s2-4 4-4 2 4 4 4 2-4 4-4 2 4 4 4\" stroke=\"#8b5cf6\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M2 16c2 0 2-4 4-4s2 4 4 4 2-4 4-4 2 4 4 4 2-4 4-4\" stroke=\"#c4b5fd\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>",
      "title": "Constructive & Destructive Interference",
      "description": "Your Wavelength Clue is like your qubit's own frequency. Applying a gate runs a logic operation on it, and when a teammate reads the interference, matching frequencies reinforce the cell (constructive) while mismatches cancel it out (destructive), the same way overlapping wave amplitudes combine or cancel in a real quantum circuit"
    },
    {
      "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"7\" cy=\"12\" r=\"4\" stroke=\"#8b5cf6\" stroke-width=\"1.8\"/><circle cx=\"17\" cy=\"12\" r=\"4\" stroke=\"#c4b5fd\" stroke-width=\"1.8\"/><path d=\"M11 12h2\" stroke=\"#8b5cf6\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>",
      "title": "Entanglement",
      "description": "Some clues ask whether two qubits in the code match or differ, a simple, tangible stand in for entangled qubits whose states are correlated no matter how far apart they are"
    },
    {
      "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\" stroke=\"#c4b5fd\"/><polyline points=\"22 4 12 14.01 9 11.01\" stroke=\"#8b5cf6\"/></svg>",
      "title": "Measurement & Decoherence",
      "description": "Why quantum measurements are irreversible and how environmental noise collapses the quantum state"
    }
  ],
